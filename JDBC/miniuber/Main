		while(c==true) {
			System.out.println("1)insertData");
			System.out.println("2)getTotalRideEachDriver");
			System.out.println("3)TopTwoDriver");
			System.out.println("4)avgRateingPerDriver");
			System.out.println("5)excixt");
			Scanner sc=new Scanner(System.in);
			System.out.println("Enter your choise");
			int n=sc.nextInt();
